@page
@model FeatureRequestPortal.Web.Pages.Accounts.PendingApprovalModel
@{
    ViewBag.PageTitle = L["PendingApprovalTitle"].Value;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <abp-card>
            <abp-card-body>
                <div class="text-center py-3">
                    <i class="fa fa-hourglass-half fa-2x text-muted mb-3"></i>
                    <h4>@L["PendingApprovalTitle"]</h4>
                    <p class="text-muted">@L["PendingApprovalDescription"]</p>
                    <a href="~/" class="btn btn-outline-secondary">@L["BackToList"]</a>
                </div>
            </abp-card-body>
        </abp-card>
    </div>
</div>
