@page
@using Volo.Abp.Users
@model FeatureRequestPortal.Web.Pages.IndexModel
@inject ICurrentUser CurrentUser
@{
    ViewBag.PageTitle = L["FeatureRequests"].Value;
}

@section scripts {
    <abp-script src="/Pages/Index.js" />
}

<abp-card>
    <abp-card-header>
        <abp-row class="align-items-center">
            <abp-column size-md="_6">
                <abp-card-title>@L["FeatureRequests"]</abp-card-title>
                <p class="text-muted mb-0">@L["FeatureRequestsDescription"]</p>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (CurrentUser.IsAuthenticated)
                {
                    <a href="/FeatureRequests/Create" class="btn btn-primary">
                        <i class="fa fa-plus me-1"></i> @L["NewFeatureRequest"]
                    </a>
                }
                else
                {
                    @* Visitors need somewhere obvious to start; the nav item alone is easy to miss. *@
                    <a href="/Accounts/SignUp" class="btn btn-primary">
                        <i class="fa fa-user-plus me-1"></i> @L["SignUp"]
                    </a>
                    <a href="/Account/Login?returnUrl=%2FFeatureRequests%2FCreate" class="btn btn-outline-primary ms-2">
                        <i class="fa fa-sign-in-alt me-1"></i> @L["Login"]
                    </a>
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="StatusFilter" class="form-label">@L["FilterByStatus"]</label>
                <select id="StatusFilter" class="form-select">
                    <option value="">@L["AllStatuses"]</option>
                    @foreach (var status in Model.Statuses)
                    {
                        <option value="@((int) status)">@L["Enum:FeatureRequestStatus." + (int) status]</option>
                    }
                </select>
            </div>
        </div>

        <abp-table striped-rows="true" id="FeatureRequestsTable"></abp-table>
    </abp-card-body>
</abp-card>
