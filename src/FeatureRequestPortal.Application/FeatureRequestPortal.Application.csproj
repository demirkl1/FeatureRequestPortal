    <PackageReference Include="Volo.Abp.Identity.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.SettingManagement.Application" Version="10.6.0" />
  </ItemGroup>

</Project>
